# ==========================================
# MovieDesk - Environment Configuration Template
# Copy this file to .env and provide your TMDB credentials
# ==========================================

# Server Port (default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# TMDB (The Movie Database) API Credentials
# Get yours at: https://www.themoviedb.org/settings/api

# TMDB API Read Access Token (v4 Bearer Token)
# Required by server.js for authenticating TMDB API proxy endpoints (/api/*)
TMDB_BEARER_TOKEN=your_tmdb_read_access_bearer_token_here

# TMDB API Key (v3 auth)
# Used for direct client-side requests or frontend configuration
TMDB_API_KEY=your_tmdb_api_key_here
